<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Bottom Sheet Handle -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="#D5D9DE" />


        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment Details"
                    android:textColor="@color/app_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_appointment_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="APT-1024"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F0FF"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="REQUESTED"
                android:textColor="@color/app_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Device & Service -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E4E8EE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repair Information"
                    android:textColor="@color/app_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <!-- Device -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Device"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_detail_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Samsung Galaxy S24"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- Service -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Service"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_detail_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Screen Replacement"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- Problem -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Problem Description"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_detail_problem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="The screen is cracked and flickers when the device is turned on."
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Appointment Information -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E4E8EE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment"
                    android:textColor="@color/app_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <!-- Branch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Branch"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_detail_branch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="TECHFIX Colombo"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_detail_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="05 Sep 2026"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="10:30 AM"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Technician -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Technician"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_detail_technician"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Not assigned yet"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Status Information -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#F3F7FF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Status"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_detail_current_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="REQUESTED"
                    android:textColor="@color/app_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_status_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your appointment is waiting for technician assignment."
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Repair History -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_repair_history"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="View Repair History"
            android:textAllCaps="false"
            android:textColor="@color/app_primary"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/app_primary" />


        <!-- Cancel Appointment -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_appointment"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Cancel Appointment"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#D32F2F" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>