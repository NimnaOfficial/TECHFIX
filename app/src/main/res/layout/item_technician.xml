<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_blue"
            android:backgroundTint="@color/icon_bg_primary">
            
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_technician"
                app:tint="@color/icon_tint_primary"/>
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technician Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary" />

            <TextView
                android:id="@+id/tv_emp_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMP-001"
                android:textSize="12sp"
                android:textColor="@color/app_text_secondary"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tv_specialization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hardware Repair"
                android:textSize="13sp"
                android:textColor="@color/app_primary"
                android:textStyle="bold"
                android:layout_marginTop="6dp"/>
                
            <TextView
                android:id="@+id/tv_branch_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branch ID"
                android:textSize="12sp"
                android:textColor="@color/app_text_secondary"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/app_divider"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/app_background">
                
                <View
                    android:id="@+id/v_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot_available" />
                    
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_quick_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/status_error"
                android:contentDescription="Delete Technician"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>






