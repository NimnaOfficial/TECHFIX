<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Success Icon -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/bg_circle_blue"
            android:backgroundTint="@color/app_primary">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />

        </FrameLayout>


        <!-- Success Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Booking Confirmed!"
            android:textColor="@color/app_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your repair appointment has been created successfully."
            android:textColor="@color/app_text_secondary"
            android:textSize="14sp" />


        <!-- Appointment ID -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#F3F7FF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment ID"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_confirmation_appointment_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="APT-1024"
                    android:textColor="@color/app_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Appointment Details -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment Details"
                    android:textColor="@color/app_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- Device -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Device"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_confirmation_device"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Samsung Galaxy S24"
                        android:textColor="@color/app_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Service -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Service"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_confirmation_service"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Screen Replacement"
                        android:textColor="@color/app_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Branch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Branch"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_confirmation_branch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="TECHFIX Colombo"
                        android:textColor="@color/app_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_confirmation_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="05 Sep 2026"
                        android:textColor="@color/app_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_confirmation_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="10:30 AM"
                        android:textColor="@color/app_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_confirmation_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="REQUESTED"
                        android:textColor="@color/app_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#F3F7FF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="You can track the status of this repair from My Appointments."
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

        </com.google.android.material.card.MaterialCardView>


        <!-- View Appointments -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_appointments"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="View My Appointments"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/app_primary"
            app:cornerRadius="16dp" />


        <!-- Back Home -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmation_home"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="@color/app_primary"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/app_primary" />

    </LinearLayout>

</ScrollView>