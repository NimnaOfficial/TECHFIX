<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="12dp">

    <!-- Timeline Dot -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <View
            android:id="@+id/timeline_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_timeline_dot"
            android:layout_marginTop="4dp" />

        <View
            android:id="@+id/timeline_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/gray_mid"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REQUESTED"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appointment created"
            android:textColor="@color/gray_light"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_changed_by"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="by John Doe (CUSTOMER)"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-08-29 14:30"
            android:textColor="#555555"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>