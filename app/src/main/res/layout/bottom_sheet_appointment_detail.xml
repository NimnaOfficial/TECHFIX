<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/app_divider"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appointment Details"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/app_text_primary"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Appt Number"
            android:textColor="@color/app_text_secondary" />
        <TextView
            android:id="@+id/tv_detail_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TF-001"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textColor="@color/app_text_secondary" />
        <TextView
            android:id="@+id/tv_detail_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Date &amp; Time"
            android:textColor="@color/app_text_secondary" />
        <TextView
            android:id="@+id/tv_detail_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-08-28 10:00"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Customer ID"
            android:textColor="@color/app_text_secondary" />
        <TextView
            android:id="@+id/tv_detail_customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USR-123"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Branch ID"
            android:textColor="@color/app_text_secondary" />
        <TextView
            android:id="@+id/tv_detail_branch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BR-001"
            android:textStyle="bold"
            android:textColor="@color/app_text_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_action"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Assign Technician"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_technician" />

</LinearLayout>
