<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="#151515">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_log_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[INFO]"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_log_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026-08-30 14:00:00"
            android:textColor="#777777"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:gravity="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_log_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GET"
            android:textColor="#03A9F4"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:background="#1103A9F4"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_log_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/api/example"
            android:textColor="#DDDDDD"
            android:fontFamily="monospace"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_log_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="API accessed"
        android:textColor="#AAAAAA"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:layout_marginTop="6dp"/>
</LinearLayout>
