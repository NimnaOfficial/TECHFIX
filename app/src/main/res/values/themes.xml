<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TECHFIX" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="M">true</item>

        <!-- Material 3 Overrides -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/app_secondary</item>
    </style>

    <style name="Widget.App.TextInputLayout.OutlinedBox.ExposedDropdownMenu.WhitePopup" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.ExposedDropdownMenu</item>
        <item name="boxStrokeColor">@color/app_primary</item>
        <item name="hintTextColor">@color/app_primary</item>
    </style>

    <style name="ThemeOverlay.App.ExposedDropdownMenu" parent="">
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
    </style>
</resources>
