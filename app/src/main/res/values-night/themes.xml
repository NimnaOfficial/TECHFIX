<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TECHFIX" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar color (Pitch Black) -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="M">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="O">false</item>

        <!-- Material 3 Overrides -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_variant</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <item name="colorSecondary">@color/app_secondary</item>
        
        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        
        <!-- Component Overrides for Modern Look -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="bottomSheetDialogTheme">@style/Theme.App.BottomSheetDialog</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <!-- Popup Menu Overrides -->
    <style name="Widget.App.TextInputLayout.OutlinedBox.ExposedDropdownMenu.WhitePopup" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.ExposedDropdownMenu</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.App.ExposedDropdownMenu" parent="">
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorOnSurface">?android:attr/textColorPrimary</item>
    </style>
</resources>

